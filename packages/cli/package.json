{
  "name": "@ztronlib/cli",
  "version": "0.1.0",
  "description": "Ztron CLI: dev/build orchestration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ztron": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "vite": "^6.0.0",
    "typescript": "^5.7.2",
    "@ztronlib/inject": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZturnLibs/ztron.git"
  },
  "bugs": {
    "url": "https://github.com/ZturnLibs/ztron/issues"
  },
  "homepage": "https://github.com/ZturnLibs/ztron#readme",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
