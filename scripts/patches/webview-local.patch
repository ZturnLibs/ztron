 inline id WKWebView_alloc() {
+  // Ztron vendored patch: let the host provide a WKWebView subclass
+  // (registered under a well-known name before webview_create) to act as
+  // the NSDraggingDestination for file drag-and-drop. Subclassing at birth
+  // (instead of isa-swizzling after init) is KVO-safe: WKWebView sets up
+  // internal KVO during init and swapping the class afterwards corrupts the
+  // observation bookkeeping (observed as _os_unfair_lock_corruption_abort
+  // in _NSSetRectValueAndNotify). Falls back to stock WKWebView.
+  if (auto cls{objc::get_class("ZtronWKWebViewSubclass")}) {
+    return objc::msg_send<id>(cls, objc::selector("alloc"));
+  }
   return objc::msg_send<id>(objc::get_class("WKWebView"),
                             objc::selector("alloc"));
 }
