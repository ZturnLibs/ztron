+inline void cocoa_wkwebview_engine::scheme_start(id /*self*/, SEL /*cmd*/,
+                                                 id /*webview*/,
+                                                 id task) noexcept {
+  objc::autoreleasepool arp;
+  try {
+    id request = objc::msg_send<id>(task, objc::selector("request"));
+    id url = objc::msg_send<id>(request, objc::selector("URL"));
+    id url_str = objc::msg_send<id>(url, objc::selector("absoluteString"));
+    const char *url_c =
+        objc::msg_send<const char *>(url_str, objc::selector("UTF8String"));
+    std::string url_text = url_c ? url_c : "";
+
+    // Map scheme://host/<path> onto <root>/<path>; `asset/<url-encoded abs
+    // path>` (convertFileSrc) serves the decoded absolute path directly.
+    std::string path = url_text;
+    auto pos = path.find("://");
+    if (pos != std::string::npos) {
+      path = path.substr(pos + 3);
+      auto slash = path.find('/');
+      path = slash == std::string::npos ? "" : path.substr(slash + 1);
+    }
+    std::string full;
+    if (path.rfind("asset/", 0) == 0) {
+      std::string enc = path.substr(6);
+      // Basic percent-decoding (%20 -> space, %2F -> /).
+      std::string dec;
+      for (size_t i = 0; i < enc.size(); ++i) {
+        if (enc[i] == '%' && i + 2 < enc.size()) {
+          auto hex = [](char c) -> int {
+            if (c >= '0' && c <= '9') return c - '0';
+            if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+            if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+            return 0;
+          };
+          dec += static_cast<char>((hex(enc[i + 1]) << 4) | hex(enc[i + 2]));
+          i += 2;
+        } else {
+          dec += enc[i];
+        }
+      }
+      full = dec;
+    } else {
+      if (path.empty()) {
+        path = "index.html";
+      }
+      full = scheme_root + "/" + path;
+    }
+
+    // Minimal MIME detection so WKWebView parses HTML/CSS/JS.
+    std::string mime = "application/octet-stream";
+    if (path.rfind(".html") != std::string::npos ||
+        path.rfind(".htm") != std::string::npos) {
+      mime = "text/html";
+    } else if (path.rfind(".js") != std::string::npos) {
+      mime = "application/javascript";
+    } else if (path.rfind(".css") != std::string::npos) {
+      mime = "text/css";
+    } else if (path.rfind(".png") != std::string::npos) {
+      mime = "image/png";
+    } else if (path.rfind(".svg") != std::string::npos) {
+      mime = "image/svg+xml";
+    }
+
+    // Serve asynchronously: read on a global queue, deliver on the main
+    // queue (WKURLSchemeTask callbacks are main-thread). Parsing above is
+    // cheap string work; the disk read is the part that must not block.
+    auto entry = std::make_shared<ztron_scheme_tasks::entry>();
+    entry->task = objc::retain(task);
+    ztron_scheme_tasks::add(entry);
+    std::string full_copy = full;
+    std::string mime_copy = mime;
+    dispatch_async_f(
+        dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0),
+        new dispatch_fn_t([entry, full_copy, mime_copy]() {
+          objc::autoreleasepool arp2;
+          // dataWithContentsOfFile: returns +0 (autoreleased by arp2);
+          // retain to hand it across the pool/queue boundary.
+          id data = objc::msg_send<id>(
+              objc::get_class("NSData"),
+              objc::selector("dataWithContentsOfFile:"),
+              NSString_stringWithUTF8String(full_copy.c_str()));
+          if (data) {
+            data = objc::retain(data);
+          }
+          dispatch_async_f(dispatch_get_main_queue(),
+                           new dispatch_fn_t([entry, data, mime_copy]() {
+                             objc::autoreleasepool arp3;
+                             ztron_scheme_tasks::delivered(entry);
+                             if (!entry->cancelled) {
+                               try {
+                                 id request = objc::msg_send<id>(
+                                     entry->task,
+                                     objc::selector("request"));
+                               id url = objc::msg_send<id>(
+                                   request, objc::selector("URL"));
+                               id headers = objc::msg_send<id>(
+                                   objc::get_class("NSMutableDictionary"),
+                                   objc::selector("dictionary"));
+                               objc::msg_send<void>(
+                                   headers,
+                                   objc::selector("setObject:forKey:"),
+                                   NSString_stringWithUTF8String(
+                                       mime_copy.c_str()),
+                                   NSString_stringWithUTF8String(
+                                       "Content-Type"));
+                               id response = objc::msg_send<id>(
+                                   objc::msg_send<id>(
+                                       objc::get_class("NSHTTPURLResponse"),
+                                       objc::selector("alloc")),
+                                   objc::selector(
+                                       "initWithURL:statusCode:HTTPVersion:"
+                                       "headerFields:"),
+                                   url,
+                                   static_cast<long>(data ? 200 : 404),
+                                   NSString_stringWithUTF8String("HTTP/1.1"),
+                                   headers);
+                               objc::msg_send<void>(
+                                   entry->task,
+                                   objc::selector("didReceiveResponse:"),
+                                   response);
+                               if (data) {
+                                 objc::msg_send<void>(
+                                     entry->task,
+                                     objc::selector("didReceiveData:"),
+                                     data);
+                               }
+                               objc::msg_send<void>(entry->task,
+                                                    objc::selector("didFinish"));
+                               } catch (...) {
+                                 // Never throw into ObjC.
+                               }
+                             }
+                             objc::release(entry->task);
+                             if (data) {
+                               objc::release(data);
+                             }
+                           }),
+                           (dispatch_function_t)([](void *arg) {
+                             auto f =
+                                 static_cast<dispatch_fn_t *>(arg);
+                             (*f)();
+                             delete f;
+                           }));
+        }),
+        (dispatch_function_t)([](void *arg) {
+          auto f = static_cast<dispatch_fn_t *>(arg);
+          (*f)();
+          delete f;
+        }));
+  } catch (const std::exception &e) {
+  } catch (...) {
+    // Never throw into ObjC.
+  }
+}
