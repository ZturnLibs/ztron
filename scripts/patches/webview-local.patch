+// ---- Ztron local fix (async scheme handler) -------------------------------
+// WKURLSchemeTask used to be served with a synchronous dataWithContentsOfFile
+// on the main thread — a large/slow asset froze the whole run loop (every
+// window stalls). Reads now run on a global concurrent queue and results are
+// delivered back on the main queue. stopURLSchemeTask flips an atomic
+// cancelled flag: delivering didReceive* on a stopped task raises
+// NSInternalInconsistencyException, and the delivery block owns the single
+// task release so stop/deliver never race.
+namespace ztron_scheme_tasks {
+struct entry {
+  id task;
+  std::atomic<bool> cancelled{false};
+};
+inline std::mutex &mutex() {
+  static std::mutex m;
+  return m;
+}
+inline std::unordered_set<std::shared_ptr<entry>> &pending() {
+  static std::unordered_set<std::shared_ptr<entry>> s;
+  return s;
+}
+inline void add(const std::shared_ptr<entry> &e) {
+  std::lock_guard<std::mutex> lk(mutex());
+  pending().insert(e);
+}
+inline void cancel(id task) {
+  std::lock_guard<std::mutex> lk(mutex());
+  auto &s = pending();
+  for (auto it = s.begin(); it != s.end(); ++it) {
+    if ((*it)->task == task) {
+      (*it)->cancelled = true;
+      s.erase(it);
+      return;
+    }
+  }
+}
+inline void delivered(const std::shared_ptr<entry> &e) {
+  std::lock_guard<std::mutex> lk(mutex());
+  pending().erase(e);
+}
