+// ---- custom scheme registration (GAP H5; webview-local) ------------------
+// Chromium refuses top-level navigations to schemes it does not know — the
+// WebResourceRequested event never fires for them — so the scheme must be
+// registered on the environment options (wry does the same via
+// ICoreWebView2EnvironmentOptions4::SetCustomSchemeRegistrations). The
+// vendored SDK header (1.0.1150) predates those interfaces; the two shapes
+// below are declared verbatim from the 1.0.2792 SDK (GUIDs are ABI
+// constants), with minimal implementations carrying only what the runtime
+// reads back (scheme name, TreatAsSecure, AllowedOrigins,
+// HasAuthorityComponent) plus safe base-option defaults.
+
+MIDL_INTERFACE("d60ac92c-37a6-4b26-a39e-95cfe59047bb")
+ICoreWebView2CustomSchemeRegistration : public IUnknown {
+public:
+  virtual /* [propget] */ HRESULT STDMETHODCALLTYPE
+  get_SchemeName(LPWSTR *schemeName) = 0;
+  virtual /* [propget] */ HRESULT STDMETHODCALLTYPE
+  get_TreatAsSecure(BOOL *treatAsSecure) = 0;
+  virtual /* [propput] */ HRESULT STDMETHODCALLTYPE
+  put_TreatAsSecure(BOOL treatAsSecure) = 0;
+  virtual HRESULT STDMETHODCALLTYPE
+  GetAllowedOrigins(UINT32 *allowedOriginsCount, LPWSTR **allowedOrigins) = 0;
+  virtual HRESULT STDMETHODCALLTYPE
+  SetAllowedOrigins(UINT32 allowedOriginsCount, LPCWSTR *allowedOrigins) = 0;
+  virtual /* [propget] */ HRESULT STDMETHODCALLTYPE
+  get_HasAuthorityComponent(BOOL *hasAuthorityComponent) = 0;
+  virtual /* [propput] */ HRESULT STDMETHODCALLTYPE
+  put_HasAuthorityComponent(BOOL hasAuthorityComponent) = 0;
+};
+
+MIDL_INTERFACE("ac52d13f-0d38-475a-9dca-876580d6793e")
+ICoreWebView2EnvironmentOptions4 : public IUnknown {
+public:
+  virtual HRESULT STDMETHODCALLTYPE GetCustomSchemeRegistrations(
+      UINT32 *count,
+      ICoreWebView2CustomSchemeRegistration ***schemeRegistrations) = 0;
+  virtual HRESULT STDMETHODCALLTYPE SetCustomSchemeRegistrations(
+      UINT32 count,
