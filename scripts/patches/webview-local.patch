+// ---- Ztron local fix (UAF on late script-message delivery) ----------------
+// A WKScriptMessage delivered after engine teardown used to dereference a
+// dangling associated `this` (SIGSEGV under destroy-flood). Engines
+// register here at construction and unregister at destructor entry; the
+// message-handler lambda refuses to dispatch through pointers that are not
+// alive anymore, so late deliveries become benign drops.
+namespace ztron_engine_liveness {
+inline std::mutex &mutex() {
+  static std::mutex m;
+  return m;
+}
+inline std::unordered_set<const void *> &live() {
+  static std::unordered_set<const void *> s;
+  return s;
+}
+inline void add(const void *p) {
+  std::lock_guard<std::mutex> lk(mutex());
+  live().insert(p);
+}
+inline void remove(const void *p) {
+  std::lock_guard<std::mutex> lk(mutex());
+  live().erase(p);
+}
+inline bool is_alive(const void *p) {
+  std::lock_guard<std::mutex> lk(mutex());
+  return live().count(p) != 0;
+}
+} // namespace ztron_engine_liveness
