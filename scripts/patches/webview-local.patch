+class ztron_env_options : public ICoreWebView2EnvironmentOptions,
+                          public ICoreWebView2EnvironmentOptions4 {
+public:
+  explicit ztron_env_options(const std::wstring &target_version)
+      : m_target_version(target_version) {}
+  virtual ~ztron_env_options() = default;
+  ztron_env_options(const ztron_env_options &) = delete;
+  ztron_env_options &operator=(const ztron_env_options &) = delete;
+
+  ULONG STDMETHODCALLTYPE AddRef() { return ++m_ref_count; }
+  ULONG STDMETHODCALLTYPE Release() {
+    if (m_ref_count > 1) {
+      return --m_ref_count;
+    }
+    delete this;
+    return 0;
+  }
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, LPVOID *ppv) {
+    if (!ppv) {
+      return E_POINTER;
+    }
+    if (IsEqualIID(riid, IID_IUnknown) ||
+        IsEqualIID(riid, IID_ICoreWebView2EnvironmentOptions)) {
+      *ppv = static_cast<ICoreWebView2EnvironmentOptions *>(this);
+    } else if (IsEqualIID(riid, __uuidof(ICoreWebView2EnvironmentOptions4))) {
+      *ppv = static_cast<ICoreWebView2EnvironmentOptions4 *>(this);
+    } else {
+      *ppv = nullptr;
+      return E_NOINTERFACE;
+    }
+    AddRef();
+    return S_OK;
+  }
+
+  // Base options: safe defaults so the runtime's version/compat checks keep
+  // behaving like the previous nullptr-options path.
+  HRESULT STDMETHODCALLTYPE
+  get_AdditionalBrowserArguments(LPWSTR *value) override {
+    if (!value) {
+      return E_POINTER;
+    }
+    return scheme_copy_wide(L"", value);
+  }
+  HRESULT STDMETHODCALLTYPE
+  put_AdditionalBrowserArguments(LPCWSTR) override {
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE get_Language(LPWSTR *value) override {
+    if (!value) {
+      return E_POINTER;
+    }
+    return scheme_copy_wide(L"", value);
+  }
+  HRESULT STDMETHODCALLTYPE put_Language(LPCWSTR) override { return S_OK; }
+  HRESULT STDMETHODCALLTYPE
+  get_TargetCompatibleBrowserVersion(LPWSTR *value) override {
+    if (!value) {
+      return E_POINTER;
+    }
+    return scheme_copy_wide(m_target_version.c_str(), value);
+  }
+  HRESULT STDMETHODCALLTYPE
+  put_TargetCompatibleBrowserVersion(LPCWSTR) override {
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE
+  get_AllowSingleSignOnUsingOSPrimaryAccount(BOOL *value) override {
+    if (!value) {
+      return E_POINTER;
+    }
+    *value = FALSE;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE
+  put_AllowSingleSignOnUsingOSPrimaryAccount(BOOL) override {
+    return S_OK;
+  }
+
+  // The runtime reads the registrations back through this getter while
+  // building the environment (the docs' CoTaskMemFree note is addressed to
+  // implementors of this exact method).
+  HRESULT STDMETHODCALLTYPE GetCustomSchemeRegistrations(
+      UINT32 *count,
+      ICoreWebView2CustomSchemeRegistration ***schemeRegistrations) override {
+    if (!count || !schemeRegistrations) {
+      return E_POINTER;
+    }
+    auto array = static_cast<ICoreWebView2CustomSchemeRegistration **>(
+        CoTaskMemAlloc(m_registrations.size() *
+                       sizeof(ICoreWebView2CustomSchemeRegistration *)));
+    if (!array) {
+      return E_OUTOFMEMORY;
+    }
+    for (size_t i = 0; i < m_registrations.size(); ++i) {
+      array[i] = m_registrations[i];
+      array[i]->AddRef();
+    }
+    *schemeRegistrations = array;
+    *count = static_cast<UINT32>(m_registrations.size());
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE SetCustomSchemeRegistrations(
+      UINT32 count,
+      ICoreWebView2CustomSchemeRegistration **schemeRegistrations) override {
+    if (count > 0 && !schemeRegistrations) {
+      return E_POINTER;
+    }
+    // Setter semantics: replace, not append — a second Set with the same
+    // scheme name would otherwise hand the runtime duplicate registrations.
+    for (auto *reg : m_registrations) {
+      reg->Release();
+    }
+    m_registrations.clear();
+    for (UINT32 i = 0; i < count; ++i) {
+      if (schemeRegistrations[i]) {
+        schemeRegistrations[i]->AddRef();
+        m_registrations.push_back(schemeRegistrations[i]);
+      }
+    }
+    return S_OK;
+  }
+
+private:
+  std::vector<ICoreWebView2CustomSchemeRegistration *> m_registrations;
+  std::wstring m_target_version;
+  std::atomic<ULONG> m_ref_count{1};
+};
