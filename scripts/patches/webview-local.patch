+inline HRESULT scheme_copy_wide(LPCWSTR src, LPWSTR *dst) {
+  size_t bytes = (wcslen(src) + 1) * sizeof(wchar_t);
+  auto buf = static_cast<LPWSTR>(CoTaskMemAlloc(bytes));
+  if (!buf) {
+    return E_OUTOFMEMORY;
+  }
+  CopyMemory(buf, src, bytes);
+  *dst = buf;
+  return S_OK;
+}
