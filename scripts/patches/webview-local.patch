+class ztron_custom_scheme_registration
+    : public ICoreWebView2CustomSchemeRegistration {
+public:
+  explicit ztron_custom_scheme_registration(const std::wstring &scheme)
+      : m_scheme(scheme) {}
+  virtual ~ztron_custom_scheme_registration() = default;
+  ztron_custom_scheme_registration(
+      const ztron_custom_scheme_registration &) = delete;
+  ztron_custom_scheme_registration &
+  operator=(const ztron_custom_scheme_registration &) = delete;
+
+  ULONG STDMETHODCALLTYPE AddRef() { return ++m_ref_count; }
+  ULONG STDMETHODCALLTYPE Release() {
+    if (m_ref_count > 1) {
+      return --m_ref_count;
+    }
+    delete this;
+    return 0;
+  }
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, LPVOID *ppv) {
+    if (!ppv) {
+      return E_POINTER;
+    }
+    if (IsEqualIID(riid, IID_IUnknown) ||
+        IsEqualIID(riid, __uuidof(ICoreWebView2CustomSchemeRegistration))) {
+      *ppv = static_cast<ICoreWebView2CustomSchemeRegistration *>(this);
+      AddRef();
+      return S_OK;
+    }
+    *ppv = nullptr;
+    return E_NOINTERFACE;
+  }
+
+  HRESULT STDMETHODCALLTYPE get_SchemeName(LPWSTR *schemeName) override {
+    if (!schemeName) {
+      return E_POINTER;
+    }
+    return scheme_copy_wide(m_scheme.c_str(), schemeName);
+  }
+  HRESULT STDMETHODCALLTYPE get_TreatAsSecure(BOOL *treatAsSecure) override {
+    if (!treatAsSecure) {
+      return E_POINTER;
+    }
+    *treatAsSecure = TRUE;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE put_TreatAsSecure(BOOL) override { return S_OK; }
+  HRESULT STDMETHODCALLTYPE
+  GetAllowedOrigins(UINT32 *allowedOriginsCount, LPWSTR **allowedOrigins) override {
+    if (!allowedOriginsCount || !allowedOrigins) {
+      return E_POINTER;
+    }
+    auto buf = static_cast<LPWSTR *>(CoTaskMemAlloc(sizeof(LPWSTR)));
+    if (!buf) {
+      return E_OUTOFMEMORY;
+    }
+    if (FAILED(scheme_copy_wide(L"*", buf))) {
+      CoTaskMemFree(buf);
+      return E_OUTOFMEMORY;
+    }
+    *allowedOrigins = buf;
+    *allowedOriginsCount = 1;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE
+  SetAllowedOrigins(UINT32, LPCWSTR *) override {
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE
+  get_HasAuthorityComponent(BOOL *hasAuthorityComponent) override {
+    if (!hasAuthorityComponent) {
+      return E_POINTER;
+    }
+    *hasAuthorityComponent = TRUE;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE put_HasAuthorityComponent(BOOL) override {
+    return S_OK;
+  }
+
+private:
+  std::wstring m_scheme;
+  std::atomic<ULONG> m_ref_count{1};
+};
